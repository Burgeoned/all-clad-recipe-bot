# Copy this file to `.env` and fill in the values. `.env` is gitignored — never commit it.
# Keep comments on their own lines (not after a value on the same line).

# --- Google OAuth (bot account: allcladclaude@gmail.com) ---
# All three are printed by: python scripts/get_refresh_token.py <client_secret.json>
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Drive ---
# The "all-clad chad" folder id — the long string in the folder's Drive URL:
# https://drive.google.com/drive/folders/<THIS_PART>
ROOT_FOLDER_ID=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Optional overrides (leave blank to use defaults) ---
# RECIPE_MODEL default: claude-haiku-4-5
RECIPE_MODEL=
# EXPORT_PDF: 1 (default) exports PDF via LibreOffice; 0 = .docx only
EXPORT_PDF=
# DRY_RUN: 1 = parse + render but skip all Drive writes; 0 (default) = normal
DRY_RUN=
